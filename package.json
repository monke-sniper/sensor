{
  "name": "sensor",
  "version": "0.1.0",
  "private": true,
  "description": "Sensor: integrated computer and internet environment",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && node tests/e2e/smoke.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "dist": "node scripts/build.mjs && node scripts/build-cli.mjs --all && electron-builder --publish never",
    "dist:win": "node scripts/build.mjs && node scripts/build-cli.mjs --all && electron-builder --win --publish never"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "koffi": "^3.3.6",
    "marked": "^18.1.2",
    "pdf-lib": "^1.17.1",
    "turndown": "^7.2.4"
  },
  "build": {
    "appId": "dev.sensor.app",
    "productName": "Sensor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "sensor.exe",
          "sensor-linux",
          "sensor-darwin"
        ]
      },
      {
        "from": "obsidian-plugin",
        "to": "obsidian-plugin"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "dist/main/indexer-worker.js",
      "node_modules/koffi/**",
      "node_modules/@lydell/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Sensor-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}
